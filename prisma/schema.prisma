// Prisma schema — Central Contábil (Navecon)
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  isAdmin         Boolean   @default(false)
  birthday        DateTime? @db.Date
  photo           String?   @db.Text
  createdAt       DateTime  @default(now())
  notifLastSeenAt DateTime?
  notifClearedAt  DateTime?

  suggestions              Suggestion[]
  suggestionVotes          SuggestionVote[]
  recados                  Recado[]
  recadoReacoes            RecadoReacao[]
  votacoes                 Votacao[]
  votacaoVotos             VotacaoVoto[]
  metas                    Meta[]
  metaNotas                MetaNota[]
  pushSubscriptions        PushSubscription[]
  aniversariosNotificados  AniversarioNotificado[]
  liderancaNotas           LiderancaNota[]
  liderancaEventos         LiderancaEvento[]
  liderancaFerias          LiderancaFerias[]
  passwordResetTokens      PasswordResetToken[]
  aniversarioEmailEnviados AniversarioEmailEnviado[]
  fichaAnexos              FichaAnexo[]
  fichaObservacoes         FichaObservacao[]

  @@map("users")
}

/**
 * ==================== Redefinição de senha ====================
 * Token de uso único enviado por e-mail em "esqueci minha senha". Expira
 * sozinho (checado na hora de usar) e é marcado como usado pra não dar
 * pra reaproveitar o mesmo link duas vezes.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/**
 * ==================== Central de notificações ====================
 * Canal único para os avisos que aparecem no sino da sidebar e, quando o
 * usuário ativa, também como notificação nativa do sistema operacional
 * (Web Push). "Lida" não é rastreado por notificação — abrir o painel do
 * sino marca tudo como visto de uma vez (User.notifLastSeenAt).
 */
model Notificacao {
  id          String   @id @default(cuid())
  kind        String
  titulo      String
  sub         String?
  href        String?
  apenasAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("notificacoes")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

// Evita repetir o aviso de "aniversário hoje" da mesma pessoa mais de uma vez no ano.
model AniversarioNotificado {
  id  String @id @default(cuid())
  ano Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ano])
  @@map("aniversarios_notificados")
}

enum SuggestionStatus {
  PENDENTE
  ANDAMENTO
  FEITO
}

model Suggestion {
  id        String           @id @default(cuid())
  text      String           @db.Text
  status    SuggestionStatus @default(PENDENTE)
  createdAt DateTime         @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes SuggestionVote[]

  @@map("suggestions")
}

model SuggestionVote {
  id    String @id @default(cuid())
  value Int

  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@map("suggestion_votes")
}

/**
 * ==================== Mural & Metas (Recados & Metas) ====================
 */

model Recado {
  id        String   @id @default(cuid())
  text      String   @db.Text
  pinned    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  anexos  RecadoAnexo[]
  reacoes RecadoReacao[]

  @@map("recados")
}

model RecadoAnexo {
  id      String @id @default(cuid())
  nome    String
  tipo    String
  tamanho Int
  dados   String @db.Text

  recadoId String
  recado   Recado @relation(fields: [recadoId], references: [id], onDelete: Cascade)

  @@map("recado_anexos")
}

enum ReacaoTipo {
  LIKE
  HEART
  DISLIKE
}

model RecadoReacao {
  id   String     @id @default(cuid())
  tipo ReacaoTipo

  recadoId String
  recado   Recado  @relation(fields: [recadoId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([recadoId, userId])
  @@map("recado_reacoes")
}

model Votacao {
  id                    String   @id @default(cuid())
  titulo                String
  createdAt             DateTime @default(now())
  encerraEm             DateTime
  notificouEncerramento Boolean  @default(false)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  opcoes VotacaoOpcao[]
  votos  VotacaoVoto[]

  @@map("votacoes")
}

model VotacaoOpcao {
  id    String @id @default(cuid())
  texto String
  ordem Int    @default(0)

  votacaoId String
  votacao   Votacao @relation(fields: [votacaoId], references: [id], onDelete: Cascade)

  votos VotacaoVoto[]

  @@map("votacao_opcoes")
}

model VotacaoVoto {
  id String @id @default(cuid())

  votacaoId String
  votacao   Votacao      @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
  opcaoId   String
  opcao     VotacaoOpcao @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([votacaoId, userId])
  @@map("votacao_votos")
}

enum MetaStatus {
  ABERTA
  CONCLUIDA
}

enum MetaNotaTipo {
  NOTA
  CONCLUSAO
  ALERTA
}

model Meta {
  id          String     @id @default(cuid())
  titulo      String
  descricao   String     @db.Text
  startDate   DateTime?  @db.Date
  endDate     DateTime   @db.Date
  reward      String?
  status      MetaStatus @default(ABERTA)
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  notas MetaNota[]

  @@map("metas")
}

model MetaNota {
  id        String       @id @default(cuid())
  text      String       @db.Text
  tipo      MetaNotaTipo @default(NOTA)
  createdAt DateTime     @default(now())

  metaId   String
  meta     Meta    @relation(fields: [metaId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("meta_notas")
}

/**
 * ==================== Análise Tributária ====================
 * Compartilhado entre todos os usuários (sem "dono") — qualquer um vê e edita
 * qualquer grupo, igual antes funcionava com localStorage, só que agora no
 * banco pra todo mundo enxergar a mesma coisa.
 */
model TributariaGrupo {
  id               String   @id @default(cuid())
  grupoNome        String
  grupoResponsavel String   @default("")
  grupoData        String   @default("")
  anoSelecionado   Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  empresas TributariaEmpresa[]

  @@map("tributaria_grupos")
}

model TributariaEmpresa {
  id              String @id @default(cuid())
  nome            String
  cnpj            String @default("")
  atividade       String
  regimeAtual     String
  prejuizoInicial Float  @default(0)

  grupoId String
  grupo   TributariaGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  dadosMensais TributariaDadosMensais[]

  @@map("tributaria_empresas")
}

model TributariaDadosMensais {
  id        String   @id @default(cuid())
  ano       Int
  dados     Json
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   TributariaEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, ano])
  @@map("tributaria_dados_mensais")
}

/**
 * ==================== Painel da Liderança ====================
 * Só administradores acessam (ver requireAdmin() nas actions e na página).
 * Sem nenhuma referência de/para outras ferramentas do site — assunto de
 * liderança fica isolado por completo dos dados dos demais módulos.
 */
model LiderancaNota {
  id        String              @id @default(cuid())
  tipo      LiderancaNotaTipo
  titulo    String
  texto     String              @db.Text
  status    LiderancaNotaStatus @default(ABERTA)
  createdAt DateTime            @default(now())

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("lideranca_notas")
}

enum LiderancaNotaTipo {
  OBSERVACAO
  META
}

enum LiderancaNotaStatus {
  ABERTA
  CONCLUIDA
}

model LiderancaEvento {
  id        String   @id @default(cuid())
  data      DateTime @db.Date
  titulo    String
  descricao String?  @db.Text
  createdAt DateTime @default(now())

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([data])
  @@map("lideranca_eventos")
}

model LiderancaFerias {
  id                   String    @id @default(cuid())
  colaborador          String
  dataInicio           DateTime  @db.Date
  dataFim              DateTime  @db.Date
  observacao           String?
  lembreteEnviadoEm    DateTime?
  // Controle dos e-mails automáticos (distintos do aviso no sino acima):
  // um 7 dias antes de começar e outro no próprio dia.
  emailLembrete7diasEm DateTime?
  emailLembreteDiaEm   DateTime?
  createdAt            DateTime  @default(now())

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([dataInicio])
  @@map("lideranca_ferias")
}

/**
 * ==================== Relatórios automáticos por e-mail ====================
 * Enviados pro e-mail de todos os administradores: um dígest mensal (todo dia
 * 28, com férias e aniversariantes do mês seguinte) e lembretes individuais
 * (7 dias antes e no dia) de férias e aniversários. Ver src/lib/cron-relatorios.ts
 * — a checagem roda de verdade em segundo plano (node-cron), não depende de
 * alguém abrir o site no dia certo.
 */
model AniversarioEmailEnviado {
  id   String @id @default(cuid())
  ano  Int
  tipo String // "7DIAS" | "DIA"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ano, tipo])
  @@map("aniversario_email_enviado")
}

model RelatorioMensalEnviado {
  id        String   @id @default(cuid())
  anoMes    String   @unique
  createdAt DateTime @default(now())

  @@map("relatorio_mensal_enviado")
}

/**
 * ==================== Ficha Informativa (transição entre analistas) ====================
 * Registro por grupo/empresa pra quando um analista sai e outro assume a
 * carteira, as peculiaridades não se perderem. Diferente da Análise
 * Tributária (que recalcula números), aqui o objetivo é só documentação:
 * dados de entrada/saída do grupo, e por empresa um histórico (tributação,
 * analista responsável, anexos e observações) mantido em ordem cronológica
 * — nunca sobrescrito, sempre acrescentado, pra servir de consulta.
 */
model FichaGrupo {
  id          String    @id @default(cuid())
  nome        String
  dataEntrada DateTime? @db.Date
  dataSaida   DateTime? @db.Date

  contabilidadeAnteriorNome    String?
  contabilidadeAnteriorCelular String?
  contabilidadeAnteriorEmail   String?

  contabilidadeNovaNome    String?
  contabilidadeNovaCelular String?
  contabilidadeNovaEmail   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresas FichaEmpresa[]

  @@map("ficha_grupos")
}

enum FichaLocalDocumentos {
  AC_DOCS
  NEXTCLOUD
  CAPSULA
  OUTRO
}

model FichaEmpresa {
  id   String @id @default(cuid())
  nome String
  cnpj String @default("")

  localDocumentos      FichaLocalDocumentos @default(AC_DOCS)
  localDocumentosOutro String?

  semMovimentacao             Boolean   @default(false)
  semMovimentacaoConfirmadoEm DateTime? @db.Date

  contatoNome     String?
  contatoTelefone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grupoId String
  grupo   FichaGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  tributacoes FichaTributacaoHistorico[]
  analistas   FichaAnalistaHistorico[]
  anexos      FichaAnexo[]
  observacoes FichaObservacao[]

  @@map("ficha_empresas")
}

// Cada troca de tributação fecha a entrada anterior (dataFim) e abre uma nova
// (dataFim null = vigente) — assim dá pra ver de qual data até qual data a
// empresa ficou em cada regime.
model FichaTributacaoHistorico {
  id         String    @id @default(cuid())
  regime     String
  dataInicio DateTime  @db.Date
  dataFim    DateTime? @db.Date
  createdAt  DateTime  @default(now())

  empresaId String
  empresa   FichaEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("ficha_tributacao_historico")
}

// Mesma lógica do histórico de tributação, só que pra saber quem foi o
// analista responsável pela empresa em cada período.
model FichaAnalistaHistorico {
  id           String    @id @default(cuid())
  nomeAnalista String
  dataInicio   DateTime  @db.Date
  dataFim      DateTime? @db.Date
  createdAt    DateTime  @default(now())

  empresaId String
  empresa   FichaEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("ficha_analista_historico")
}

model FichaAnexo {
  id              String   @id @default(cuid())
  nome            String
  tipo            String
  tamanho         Int
  dados           String   @db.Text
  observacao      String?  @db.Text
  // Marca prints anexados como comprovante de "empresa sem movimentação"
  // (aparecem numa lista à parte, junto da confirmação, em vez de nos
  // anexos gerais).
  semMovimentacao Boolean  @default(false)
  createdAt       DateTime @default(now())

  empresaId String
  empresa   FichaEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("ficha_anexos")
}

model FichaObservacao {
  id        String   @id @default(cuid())
  texto     String   @db.Text
  createdAt DateTime @default(now())

  empresaId String
  empresa   FichaEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("ficha_observacoes")
}
